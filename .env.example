# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# --- Google Sheets (form persistence via Apps Script Web App) ---
# See docs/GOOGLE_SHEETS_SETUP.md for full step-by-step setup instructions.
# No GCP project, service account, or key file needed — this calls a script
# deployed directly from inside your Google Sheet, under your own account.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec
# Generate this by running generateAndStoreSecret() once in the Apps Script
# editor (docs/apps-script/Code.gs) and copying the value it logs.
GOOGLE_APPS_SCRIPT_SECRET=your-generated-shared-secret

# --- Email notifications (Resend) ---
# See docs/GOOGLE_SHEETS_SETUP.md "Email Notifications" section.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sending address/domain in your Resend account.
NOTIFICATION_FROM_EMAIL=Daxar Website <notifications@daxarenterprises.com>
# Where new-submission notifications are sent. Defaults to info@daxarenterprises.com if unset.
NOTIFICATION_EMAIL=info@daxarenterprises.com
